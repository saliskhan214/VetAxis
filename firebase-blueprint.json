{
  "entities": {
    "User": {
      "title": "User",
      "description": "A VetAxis user account (doctor, clinic, assistant, or pet owner)",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "description": "The Firebase Auth user ID"
        },
        "name": {
          "type": "string",
          "description": "Display name of the user"
        },
        "email": {
          "type": "string",
          "format": "email",
          "description": "User email address"
        },
        "phone": {
          "type": "string",
          "description": "Contact phone number"
        },
        "role": {
          "type": "string",
          "enum": [
            "doctor",
            "clinic",
            "assistant",
            "user",
            "vendor"
          ],
          "description": "Account role"
        },
        "expertise": {
          "type": "string",
          "description": "Professional expertise (doctors/assistants only)"
        },
        "facilities": {
          "type": "string",
          "description": "Clinic facilities listed (clinics only)"
        },
        "address": {
          "type": "string",
          "description": "Physical address"
        },
        "profilePic": {
          "type": "string",
          "description": "Base64 image string or default string"
        },
        "createdAt": {
          "type": "number",
          "description": "Creation timestamp in milliseconds"
        },
        "location": {
          "type": "object",
          "description": "Geographical location object",
          "properties": {
            "lat": {
              "type": "number"
            },
            "lng": {
              "type": "number"
            },
            "address": {
              "type": "string"
            }
          }
        },
        "isVerified": {
          "type": "boolean"
        },
        "promoAdsUsed": {
          "type": "number",
          "description": "Number of promotional ads created using subscription limits"
        },
        "subscriptionTier": {
          "type": "string",
          "enum": [
            "Silver",
            "Gold",
            "Platinum"
          ]
        },
        "subscriptionExpiresAt": {
          "type": "number"
        },
        "avgRating": {
          "type": "number"
        },
        "totalReviews": {
          "type": "number"
        }
      },
      "required": [
        "name",
        "email",
        "role",
        "createdAt"
      ]
    },
    "Review": {
      "title": "Review",
      "description": "A review with a rating left by another user",
      "type": "object",
      "properties": {
        "reviewerEmail": {
          "type": "string"
        },
        "reviewerName": {
          "type": "string"
        },
        "reviewerRole": {
          "type": "string"
        },
        "rating": {
          "type": "number"
        },
        "comment": {
          "type": "string"
        },
        "date": {
          "type": "number"
        }
      },
      "required": [
        "reviewerEmail",
        "reviewerName",
        "rating",
        "date"
      ]
    },
    "PetAd": {
      "title": "PetAd",
      "description": "An advertisement for pet adoption or sale",
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "adType": {
          "type": "string",
          "enum": [
            "sale",
            "adoption"
          ]
        },
        "petType": {
          "type": "string"
        },
        "breed": {
          "type": "string"
        },
        "age": {
          "type": "number"
        },
        "price": {
          "type": "number"
        },
        "description": {
          "type": "string"
        },
        "location": {
          "type": "string"
        },
        "whatsapp": {
          "type": "string"
        },
        "image": {
          "type": "string"
        },
        "ownerEmail": {
          "type": "string"
        },
        "ownerName": {
          "type": "string"
        },
        "ownerRole": {
          "type": "string"
        },
        "createdAt": {
          "type": "number"
        }
      },
      "required": [
        "adType",
        "petType",
        "description",
        "location",
        "whatsapp",
        "ownerEmail",
        "createdAt"
      ]
    },
    "Product": {
      "title": "Product",
      "description": "A pet accessory or product for sale in the marketplace",
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "price": {
          "type": "number"
        },
        "quantity": {
          "type": "number"
        },
        "description": {
          "type": "string"
        },
        "whatsapp": {
          "type": "string"
        },
        "image": {
          "type": "string"
        },
        "ownerEmail": {
          "type": "string"
        },
        "ownerName": {
          "type": "string"
        },
        "ownerRole": {
          "type": "string"
        },
        "createdAt": {
          "type": "number"
        }
      },
      "required": [
        "name",
        "price",
        "quantity",
        "description",
        "whatsapp",
        "ownerEmail",
        "createdAt"
      ]
    },
    "CommunityPost": {
      "title": "CommunityPost",
      "description": "A message or query shared on the public community board",
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "authorEmail": {
          "type": "string"
        },
        "authorName": {
          "type": "string"
        },
        "role": {
          "type": "string"
        },
        "profilePic": {
          "type": "string"
        },
        "text": {
          "type": "string"
        },
        "category": {
          "type": "string",
          "enum": [
            "lost",
            "adoption",
            "help",
            "general",
            "emergency",
            "ask_vet"
          ]
        },
        "ts": {
          "type": "number"
        },
        "reactions": {
          "type": "object"
        },
        "answers": {
          "type": "array",
          "description": "Answers from verified practitioners"
        }
      },
      "required": [
        "authorEmail",
        "authorName",
        "text",
        "category",
        "ts"
      ]
    },
    "JobPost": {
      "title": "JobPost",
      "description": "A veterinary or assistant job posting published by a clinic",
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "clinicId": {
          "type": "string"
        },
        "clinicName": {
          "type": "string"
        },
        "clinicEmail": {
          "type": "string"
        },
        "title": {
          "type": "string"
        },
        "jobType": {
          "type": "string",
          "enum": [
            "Full-time",
            "Part-time",
            "Freelance",
            "Internship"
          ]
        },
        "location": {
          "type": "string"
        },
        "salaryMin": {
          "type": "number"
        },
        "salaryMax": {
          "type": "number"
        },
        "experience": {
          "type": "string"
        },
        "workingHours": {
          "type": "string"
        },
        "genderPreference": {
          "type": "string",
          "enum": [
            "No Preference",
            "Male",
            "Female"
          ]
        },
        "deadline": {
          "type": "string"
        },
        "positions": {
          "type": "number"
        },
        "status": {
          "type": "string",
          "enum": [
            "open",
            "closed"
          ]
        },
        "screeningQuestions": {
          "type": "array"
        },
        "requiredDocuments": {
          "type": "array"
        },
        "minQualificationGate": {
          "type": "string",
          "enum": [
            "none",
            "assistant",
            "doctor"
          ]
        },
        "createdAt": {
          "type": "number"
        }
      },
      "required": [
        "clinicId",
        "clinicName",
        "clinicEmail",
        "title",
        "jobType",
        "location",
        "salaryMin",
        "salaryMax",
        "deadline",
        "createdAt"
      ]
    },
    "JobApplication": {
      "title": "JobApplication",
      "description": "An application submitted by a candidate for a clinic job posting",
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "jobId": {
          "type": "string"
        },
        "clinicId": {
          "type": "string"
        },
        "applicantId": {
          "type": "string"
        },
        "applicantName": {
          "type": "string"
        },
        "applicantEmail": {
          "type": "string"
        },
        "applicantPhone": {
          "type": "string"
        },
        "applicantRole": {
          "type": "string"
        },
        "answers": {
          "type": "array"
        },
        "submittedDocs": {
          "type": "object"
        },
        "status": {
          "type": "string",
          "enum": [
            "Pending",
            "Reviewed",
            "Shortlisted",
            "Rejected",
            "Hired"
          ]
        },
        "createdAt": {
          "type": "number"
        }
      },
      "required": [
        "jobId",
        "clinicId",
        "applicantId",
        "applicantName",
        "applicantEmail",
        "status",
        "createdAt"
      ]
    },
    "VetNotification": {
      "title": "VetNotification",
      "description": "A notification item representing an access, like, post reaction or job status update",
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "userId": {
          "type": "string",
          "description": "The recipient's user UID"
        },
        "senderId": {
          "type": "string",
          "description": "The initiator's user UID"
        },
        "senderName": {
          "type": "string",
          "description": "Display name of the initiator"
        },
        "type": {
          "type": "string",
          "enum": [
            "like",
            "comment",
            "apply",
            "status_change"
          ],
          "description": "Type of event"
        },
        "targetId": {
          "type": "string",
          "description": "ID of post or job or application or farm"
        },
        "targetType": {
          "type": "string",
          "enum": [
            "post",
            "job",
            "application",
            "appointment"
          ],
          "description": "Target entity category"
        },
        "message": {
          "type": "string",
          "description": "Display text of the alert"
        },
        "read": {
          "type": "boolean",
          "description": "Whether the user read the notification"
        },
        "createdAt": {
          "type": "number",
          "description": "Event timestamp"
        }
      },
      "required": [
        "userId",
        "senderId",
        "senderName",
        "type",
        "targetId",
        "targetType",
        "message",
        "read",
        "createdAt"
      ]
    },
    "PromotionalAd": {
      "title": "PromotionalAd",
      "description": "A paid campaign advertisement by a doctor or clinic",
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "sponsorName": {
          "type": "string"
        },
        "title": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "couponCode": {
          "type": "string"
        },
        "ctaText": {
          "type": "string"
        },
        "ctaUrl": {
          "type": "string"
        },
        "bgGradient": {
          "type": "string"
        },
        "badge": {
          "type": "string"
        },
        "icon": {
          "type": "string"
        },
        "ownerEmail": {
          "type": "string"
        },
        "ownerUid": {
          "type": "string"
        },
        "ownerRole": {
          "type": "string",
          "enum": [
            "doctor",
            "clinic"
          ]
        },
        "pricePaid": {
          "type": "number",
          "enum": [
            0,
            1000,
            1500
          ]
        },
        "durationDays": {
          "type": "number",
          "enum": [
            3,
            7
          ]
        },
        "expiresAt": {
          "type": "number"
        },
        "createdAt": {
          "type": "number"
        }
      },
      "required": [
        "sponsorName",
        "title",
        "description",
        "ctaText",
        "ctaUrl",
        "ownerUid",
        "ownerEmail",
        "ownerRole",
        "pricePaid",
        "durationDays",
        "expiresAt",
        "createdAt"
      ]
    },
    "Conversation": {
      "title": "Conversation",
      "description": "A direct consultation conversation between a pet owner/farmer and veterinary doctor/clinic",
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "participantIds": {
          "type": "array"
        },
        "lastMessage": {
          "type": "string"
        },
        "lastMessageTime": {
          "type": "number"
        },
        "lastSenderId": {
          "type": "string"
        },
        "createdAt": {
          "type": "number"
        },
        "updatedAt": {
          "type": "number"
        }
      },
      "required": [
        "participantIds",
        "createdAt",
        "updatedAt"
      ]
    },
    "ChatMessage": {
      "title": "ChatMessage",
      "description": "An instant chat message within a conversation with 15-day retention and sent/delivered/seen ticks",
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "conversationId": {
          "type": "string"
        },
        "senderId": {
          "type": "string"
        },
        "senderName": {
          "type": "string"
        },
        "receiverId": {
          "type": "string"
        },
        "text": {
          "type": "string"
        },
        "timestamp": {
          "type": "number"
        },
        "status": {
          "type": "string",
          "enum": [
            "sent",
            "delivered",
            "seen"
          ]
        },
        "createdAt": {
          "type": "number"
        }
      },
      "required": [
        "conversationId",
        "senderId",
        "receiverId",
        "text",
        "timestamp",
        "status",
        "createdAt"
      ]
    },
    "AdminBroadcast": {
      "title": "AdminBroadcast",
      "description": "System-wide broadcast notification sent by administrator to all users with in-app and browser notifications",
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "adminUid": {
          "type": "string"
        },
        "adminName": {
          "type": "string"
        },
        "adminEmail": {
          "type": "string"
        },
        "title": {
          "type": "string"
        },
        "message": {
          "type": "string"
        },
        "category": {
          "type": "string"
        },
        "targetAudience": {
          "type": "string"
        },
        "priority": {
          "type": "string"
        },
        "recipientCount": {
          "type": "number"
        },
        "sendInApp": {
          "type": "boolean"
        },
        "sendBrowser": {
          "type": "boolean"
        },
        "createdAt": {
          "type": "number"
        }
      },
      "required": [
        "id",
        "adminUid",
        "title",
        "message",
        "category",
        "targetAudience",
        "createdAt"
      ]
    }
  },
  "firestore": {
    "/admin_broadcasts/{broadcastId}": {
      "schema": "AdminBroadcast",
      "description": "System-wide broadcast notifications sent by platform administrators to all users"
    },
    "/users/{userId}": {
      "schema": "User",
      "description": "Subscribers' personal configuration, location, role details"
    },
    "/users/{userId}/reviews/{reviewId}": {
      "schema": "Review",
      "description": "Feedback reviews left for a specific doctor, clinic, or assistant"
    },
    "/pet_ads/{adId}": {
      "schema": "PetAd",
      "description": "Registered classified ads for pet adoptions and sales"
    },
    "/marketplace_products/{productId}": {
      "schema": "Product",
      "description": "Items listed by doctors or clinics on the shop board"
    },
    "/community_posts/{postId}": {
      "schema": "CommunityPost",
      "description": "Broadcast notifications and collaborative bulletin boards"
    },
    "/job_posts/{jobId}": {
      "schema": "JobPost",
      "description": "Job listings published by clinics seeking doctor/assistant candidates"
    },
    "/job_applications/{applicationId}": {
      "schema": "JobApplication",
      "description": "Candidate applications detailing screening answers and qualification narratives"
    },
    "/notifications/{notificationId}": {
      "schema": "VetNotification",
      "description": "Personal notifications for likes, job applications, or status updates targeted to a user"
    },
    "/livestock_farms/{farmId}": {
      "schema": "LivestockFarm",
      "description": "Agricultural livestock farms managed by owners, teams, and veterinary physicians"
    },
    "/livestock_animals/{animalId}": {
      "schema": "LivestockAnimal",
      "description": "Individual animal profiles on a specific farm"
    },
    "/livestock_batches/{batchId}": {
      "schema": "LivestockBatch",
      "description": "Flock and batch entries registered on a farm"
    },
    "/livestock_tasks/{taskId}": {
      "schema": "LivestockTask",
      "description": "Hub of medical treatments, breeding tasks, and preventative vaccination events"
    },
    "/promotional_ads/{adId}": {
      "schema": "PromotionalAd",
      "description": "Paid advertising campaigns created by veterinarians and clinics"
    },
    "/livestock_individual_records/{recordId}": {
      "schema": "IndividualAnimalRecord",
      "description": "Comprehensive individual life file records for specific animals"
    },
    "/livestock_herd_records/{recordId}": {
      "schema": "HerdLevelMasterRecord",
      "description": "Comprehensive monthly/yearly herd registers and inventories"
    },
    "/conversations/{conversationId}": {
      "schema": "Conversation",
      "description": "Direct clinical consultations between users and veterinary providers"
    },
    "/conversations/{conversationId}/messages/{messageId}": {
      "schema": "ChatMessage",
      "description": "Individual consultation messages retained for 15 days with live single/double/blue ticks"
    }
  }
}